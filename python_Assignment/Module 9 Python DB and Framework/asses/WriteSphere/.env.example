# Copy to .env and adjust. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated hostnames for production (PythonAnywhere: your-user.pythonanywhere.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Set USE_MYSQL=1 after creating a MySQL database (local or PythonAnywhere)
USE_MYSQL=0

DB_NAME=writesphere
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional email (password reset etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
